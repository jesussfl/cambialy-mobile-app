<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="0dp"
  android:layout_marginBottom="6dp"
  android:layout_weight="1"
  android:background="@drawable/rates_widget_row_background"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingHorizontal="12dp">

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/rates_widget_badge_usd"
    android:paddingHorizontal="8dp"
    android:paddingVertical="3dp"
    android:text="@string/rates_widget_usd_badge"
    android:textColor="@color/rates_widget_badge_usd_text"
    android:textSize="11sp"
    android:textStyle="bold" />

  <TextView
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_weight="1"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="@string/rates_widget_usd_label"
    android:textColor="@color/rates_widget_text_secondary"
    android:textSize="12sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/rates_widget_usd_value"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:maxLines="1"
    android:text="@string/rates_widget_unavailable"
    android:textColor="@color/rates_widget_primary"
    android:textSize="13sp"
    android:textStyle="bold" />
</LinearLayout>
