<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/trend_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_modern_background"
  android:orientation="vertical"
  android:padding="16dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/trend_widget_badge_usd"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/rates_widget_badge_usd"
      android:paddingHorizontal="7dp"
      android:paddingVertical="3dp"
      android:text="@string/widget_ticker_usd"
      android:textColor="@color/rates_widget_badge_usd_text"
      android:textSize="11sp"
      android:textStyle="bold"
      android:visibility="gone" />

    <TextView
      android:id="@+id/trend_widget_badge_eur"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/rates_widget_badge_eur"
      android:paddingHorizontal="7dp"
      android:paddingVertical="3dp"
      android:text="@string/widget_ticker_eur"
      android:textColor="@color/rates_widget_badge_eur_text"
      android:textSize="11sp"
      android:textStyle="bold"
      android:visibility="gone" />

    <TextView
      android:id="@+id/trend_widget_badge_usdt"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:background="@drawable/rates_widget_badge_usdt"
      android:paddingHorizontal="7dp"
      android:paddingVertical="3dp"
      android:text="@string/widget_ticker_usdt"
      android:textColor="@color/rates_widget_badge_usdt_text"
      android:textSize="11sp"
      android:textStyle="bold"
      android:visibility="gone" />

    <TextView
      android:id="@+id/trend_widget_source"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="7dp"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/widget_source_bcv"
      android:textColor="@color/rates_widget_text_secondary"
      android:textSize="12sp"
      android:textStyle="bold" />

    <FrameLayout
      android:layout_width="30dp"
      android:layout_height="30dp">

      <ImageView
        android:id="@+id/trend_widget_refresh"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/rates_widget_refresh_background"
        android:contentDescription="@string/rates_widget_refresh"
        android:padding="7dp"
        android:src="@drawable/ic_refresh" />

      <ProgressBar
        android:id="@+id/trend_widget_progress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center"
        android:visibility="gone" />
    </FrameLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="12dp"
    android:layout_weight="1"
    android:background="@drawable/widget_modern_surface"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <TextView
      android:id="@+id/trend_widget_value"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/rates_widget_unavailable"
      android:textColor="@color/rates_widget_text_primary"
      android:textSize="26sp"
      android:textStyle="bold" />

    <!-- One pre-styled variant per direction, so the up/down colours come from
         res/values + res/values-night rather than being resolved in our process. -->
    <TextView
      android:id="@+id/trend_widget_delta_up"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/widget_trend_up"
      android:textSize="14sp"
      android:textStyle="bold"
      android:visibility="gone" />

    <TextView
      android:id="@+id/trend_widget_delta_down"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:textColor="@color/widget_trend_down"
      android:textSize="14sp"
      android:textStyle="bold"
      android:visibility="gone" />

    <TextView
      android:id="@+id/trend_widget_delta_flat"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/widget_trend_flat"
      android:textColor="@color/rates_widget_text_secondary"
      android:textSize="14sp"
      android:textStyle="bold"
      android:visibility="gone" />
  </LinearLayout>

  <TextView
    android:id="@+id/trend_widget_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="@string/rates_widget_loading"
    android:textColor="@color/rates_widget_text_secondary"
    android:textSize="11sp" />
</LinearLayout>
