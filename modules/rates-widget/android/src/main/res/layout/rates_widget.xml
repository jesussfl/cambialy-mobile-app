<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/rates_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/rates_widget_background"
  android:orientation="vertical"
  android:padding="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/rates_widget_title"
      android:textColor="#07101F"
      android:textSize="15sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/rates_widget_refresh"
      android:layout_width="32dp"
      android:layout_height="28dp"
      android:background="@drawable/rates_widget_refresh_background"
      android:gravity="center"
      android:text="@string/rates_widget_refresh"
      android:textColor="#FFFFFF"
      android:textSize="14sp"
      android:textStyle="bold" />
  </LinearLayout>

  <ProgressBar
    android:id="@+id/rates_widget_progress"
    style="?android:attr/progressBarStyleSmall"
    android:layout_width="24dp"
    android:layout_height="24dp"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="6dp"
    android:visibility="gone" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="8dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <include layout="@layout/rates_widget_usd_row" />
    <include layout="@layout/rates_widget_eur_row" />
    <include layout="@layout/rates_widget_usdt_row" />
  </LinearLayout>

  <TextView
    android:id="@+id/rates_widget_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="@string/rates_widget_loading"
    android:textColor="#64748B"
    android:textSize="11sp" />
</LinearLayout>
