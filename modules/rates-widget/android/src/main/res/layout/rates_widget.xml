<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/rates_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/rates_widget_background"
  android:orientation="vertical"
  android:padding="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="@string/rates_widget_title"
      android:textColor="@color/rates_widget_text_primary"
      android:textSize="15sp"
      android:textStyle="bold" />

    <FrameLayout
      android:layout_width="32dp"
      android:layout_height="32dp">

      <ImageView
        android:id="@+id/rates_widget_refresh"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/rates_widget_refresh_background"
        android:contentDescription="@string/rates_widget_refresh"
        android:padding="7dp"
        android:src="@drawable/ic_refresh" />

      <ProgressBar
        android:id="@+id/rates_widget_progress"
        style="?android:attr/progressBarStyleSmall"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center"
        android:visibility="gone" />
    </FrameLayout>
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_marginTop="10dp"
    android:layout_weight="1"
    android:orientation="vertical">

    <include layout="@layout/rates_widget_usd_row" />
    <include layout="@layout/rates_widget_eur_row" />
    <include layout="@layout/rates_widget_usdt_row" />
  </LinearLayout>

  <TextView
    android:id="@+id/rates_widget_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="@string/rates_widget_loading"
    android:textColor="@color/rates_widget_text_secondary"
    android:textSize="11sp" />
</LinearLayout>
