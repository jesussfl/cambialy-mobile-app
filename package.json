    "ios": "expo run:ios --device",
    "ios:staging": "APP_ENV=staging expo run:ios --device",
    "build:ios": "expo run:ios --device --configuration Release",
    "build:ios:staging": "APP_ENV=staging expo run:ios --device --configuration Release",
