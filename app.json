{
  "expo": {
    "name": "Cambialy",
    "slug": "cambialy",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/cambialy.png",
    "scheme": "cambialy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/cambialy.png",
      "bundleIdentifier": "com.cambialy.app",
      "appleTeamId": "R28JX6275H"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/cambialy-foreground-2.png",
        "backgroundImage": "./assets/images/cambialy-background.png",
        "monochromeImage": "./assets/images/cambialy-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cambialy.app",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withFirebaseAppDistribution",
      "./plugins/withIosBuildReactNativeFromSource",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0350FF",
          "android": {
            "image": "./assets/images/cambialy-monochrome.png",
            "imageWidth": 156
          },
          "ios": {
            "image": "./assets/images/cambialy-monochrome.png",
            "imageWidth": 156
          }
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.cambialy.app.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.cambialy.app",
          "widgets": [
            {
              "name": "RatesWidget",
              "displayName": "Tasas Cambialy",
              "description": "Consulta USD BCV, EUR BCV y USDT Binance",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge"
              ]
            }
          ]
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
