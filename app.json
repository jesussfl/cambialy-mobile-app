{
  "expo": {
    "name": "Cambialy",
    "slug": "cambialy",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/cambialy.png",
    "scheme": "cambialy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/cambialy.png",
      "bundleIdentifier": "com.cambialy.app",
      "appleTeamId": "R28JX6275H"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/cambialy-foreground-2.png",
        "backgroundImage": "./assets/images/cambialy-background.png",
        "monochromeImage": "./assets/images/cambialy-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cambialy.app",
      "versionCode": 2,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withFirebaseAppDistribution",
      "./plugins/withIosBuildReactNativeFromSource",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Figtree-Light.ttf",
            "./assets/fonts/Figtree-Regular.ttf",
            "./assets/fonts/Figtree-Medium.ttf",
            "./assets/fonts/Figtree-SemiBold.ttf",
            "./assets/fonts/Figtree-Bold.ttf",
            "./assets/fonts/Figtree-ExtraBold.ttf",
            "./assets/fonts/Figtree-Black.ttf",
            "./assets/fonts/Figtree-Italic.ttf",
            "./assets/fonts/Figtree-LightItalic.ttf",
            "./assets/fonts/Figtree-MediumItalic.ttf",
            "./assets/fonts/Figtree-SemiBoldItalic.ttf",
            "./assets/fonts/Figtree-BoldItalic.ttf",
            "./assets/fonts/Figtree-ExtraBoldItalic.ttf",
            "./assets/fonts/Figtree-BlackItalic.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Figtree",
                "fontDefinitions": [
                  { "path": "./assets/fonts/Figtree-Light.ttf", "weight": 300 },
                  { "path": "./assets/fonts/Figtree-Regular.ttf", "weight": 400 },
                  { "path": "./assets/fonts/Figtree-Medium.ttf", "weight": 500 },
                  { "path": "./assets/fonts/Figtree-SemiBold.ttf", "weight": 600 },
                  { "path": "./assets/fonts/Figtree-Bold.ttf", "weight": 700 },
                  { "path": "./assets/fonts/Figtree-ExtraBold.ttf", "weight": 800 },
                  { "path": "./assets/fonts/Figtree-Black.ttf", "weight": 900 },
                  { "path": "./assets/fonts/Figtree-Italic.ttf", "weight": 400, "style": "italic" },
                  { "path": "./assets/fonts/Figtree-LightItalic.ttf", "weight": 300, "style": "italic" },
                  { "path": "./assets/fonts/Figtree-MediumItalic.ttf", "weight": 500, "style": "italic" },
                  { "path": "./assets/fonts/Figtree-SemiBoldItalic.ttf", "weight": 600, "style": "italic" },
                  { "path": "./assets/fonts/Figtree-BoldItalic.ttf", "weight": 700, "style": "italic" },
                  { "path": "./assets/fonts/Figtree-ExtraBoldItalic.ttf", "weight": 800, "style": "italic" },
                  { "path": "./assets/fonts/Figtree-BlackItalic.ttf", "weight": 900, "style": "italic" }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0350FF",
          "android": {
            "image": "./assets/images/cambialy-monochrome.png",
            "imageWidth": 156
          },
          "ios": {
            "image": "./assets/images/cambialy-monochrome.png",
            "imageWidth": 156
          }
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.cambialy.app.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.cambialy.app",
          "widgets": [
            {
              "name": "RatesWidget",
              "displayName": "Tasas Cambialy",
              "description": "Consulta USD BCV, EUR BCV y USDT Binance",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge"
              ]
            }
          ]
        }
      ],
      "expo-status-bar",
      "./plugins/withAndroidR8",
      "./plugins/withHermesMmap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
